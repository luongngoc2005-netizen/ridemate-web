VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional public map services. No Google billing/API key required.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_MOTORCYCLE_ROUTER_URL=https://valhalla1.openstreetmap.de/route
VITE_GEOCODER_URL=https://photon.komoot.io/api/
VITE_PLACES_URL=https://overpass-api.de/api/interpreter

# Server-only AI settings. Never prefix the API key with VITE_.
AI_PROVIDER=openai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# vLLM Chat Completions (AI_PROVIDER=vllm). Server-only; key is optional.
# Use your Cloudflare HTTPS URL with /v1, or http://localhost:8036/v1
# when the RideMate backend and vLLM run on the same machine.
VLLM_BASE_URL=
VLLM_MODEL=ridemate-qwen
VLLM_API_KEY=

# Render automatically supplies RENDER_EXTERNAL_HOSTNAME. For a custom domain,
# set its exact origin below (scheme + host, no path). For local npm start use
# APP_ORIGIN=http://localhost:10000. Vite development does not require this.
APP_ORIGIN=
# Backend reuses VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY above.
# Optional server overrides (same Supabase project as frontend):
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Render supplies PORT. Local default is 10000.
